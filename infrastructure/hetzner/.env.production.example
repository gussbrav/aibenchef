# =========================================================================
# Variables de entorno PRODUCCION en Hetzner VPS.
# Copiar a .env.production en el VPS (NUNCA commitear).
# Generar secrets con: openssl rand -hex 32
# =========================================================================

# --- Postgres ---
POSTGRES_USER=aibenchef
POSTGRES_PASSWORD=                       # openssl rand -hex 32

# --- API ---
API_SECRET_KEY=                          # openssl rand -hex 64 (JWT signing)

# --- Cube.dev ---
CUBEJS_API_SECRET=                       # openssl rand -hex 32

# --- MinIO ---
MINIO_ROOT_USER=aibenchef-admin
MINIO_ROOT_PASSWORD=                     # openssl rand -hex 32

# --- Sentry (opcional, dejar vacio para no enviar) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Email transaccional (Resend free 3k/mes) ---
RESEND_API_KEY=
EMAIL_FROM=Aibenchef <noreply@aibenchef.azoramind.com>

# --- Stripe (cuando entre billing, Fase 5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
