#!/usr/bin/env sh
# Pre-push hook — Aibenchef
#
# Capa 1 de defensa contra bugs: corre lint + tests rapidos antes de cada push.
# Objetivo: <3s en el caso comun (solo archivos Python tocados).
#
# Instalacion:
#   git config core.hooksPath .githooks
#
# Bypass de emergencia (NO recomendado):
#   git push --no-verify

set -e

# --- Colores -------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RESET='\033[0m'

# --- Detectar archivos Python tocados en este push -----------------------
# Si el push es a una rama nueva, comparamos contra origin/main.
# Si es a una existente, contra el HEAD remoto.
remote="$1"
url="$2"
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')

changed_files=""
while read local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$zero" ]; then
        # Push de delete branch — nada que checkear
        continue
    fi
    if [ "$remote_sha" = "$zero" ]; then
        # Rama nueva — comparar contra origin/main
        range="origin/main..$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    files=$(git diff --name-only --diff-filter=ACM "$range" 2>/dev/null || true)
    changed_files="$changed_files
$files"
done

# Filtrar archivos Python dentro de data-platform/
py_files=$(echo "$changed_files" | grep -E '^data-platform/.*\.py$' | sort -u || true)
# Archivos TypeScript/TSX bajo apps/web/ (para el check server-only)
web_ts_files=$(echo "$changed_files" | grep -E '^apps/web/.*\.(ts|tsx)$' | sort -u || true)

# --- Check 0: server-only leaks en client components (bug de EasyPanel 2ae6082)
# Corre solo si hay cambios de TS bajo apps/web/ Y node esta disponible.
if [ -n "$web_ts_files" ] && command -v node > /dev/null 2>&1; then
    printf "${BLUE}[pre-push]${RESET} Verificando client components (server-only leaks)..."
    if ! (cd apps/web && node scripts/check-server-only-in-client.mjs > /dev/null 2>&1); then
        printf "${RED}\n[pre-push] FAIL: server-only leak en client component.${RESET}\n"
        printf "${YELLOW}  Detalle:${RESET} cd apps/web && node scripts/check-server-only-in-client.mjs\n"
        exit 1
    fi
    printf " ${GREEN}OK${RESET}\n"
fi

if [ -z "$py_files" ]; then
    printf "${BLUE}[pre-push]${RESET} Sin cambios en archivos Python — skip lint Python.\n"
    exit 0
fi

n_files=$(echo "$py_files" | wc -l | tr -d ' ')
printf "${BLUE}[pre-push]${RESET} Verificando %s archivos Python...\n" "$n_files"

# --- Lint con ruff (sobre archivos staged solamente) ---------------------
printf "${BLUE}[1/2]${RESET} Ruff check..."
cd data-platform
# Pasamos los paths relativos a data-platform/
ruff_targets=$(echo "$py_files" | sed 's|^data-platform/||')
if ! uv run ruff check $ruff_targets 2>&1; then
    printf "${RED}\n[pre-push] FAIL: ruff check encontro errores.${RESET}\n"
    printf "${YELLOW}  Fix con:${RESET} cd data-platform && uv run ruff check --fix .\n"
    exit 1
fi
printf " ${GREEN}OK${RESET}\n"

# --- Format check --------------------------------------------------------
printf "${BLUE}[2/2]${RESET} Ruff format..."
if ! uv run ruff format --check $ruff_targets > /dev/null 2>&1; then
    printf "${RED}\n[pre-push] FAIL: archivos sin formatear.${RESET}\n"
    printf "${YELLOW}  Fix con:${RESET} cd data-platform && uv run ruff format .\n"
    exit 1
fi
printf " ${GREEN}OK${RESET}\n"

# --- Tests rapidos (-m "not slow and not integration") -------------------
# Solo si hay cambios bajo src/ — si solo cambiaron tests, los corremos igual.
src_changed=$(echo "$py_files" | grep -E '^data-platform/(src|tests)/' || true)
if [ -n "$src_changed" ]; then
    printf "${BLUE}[bonus]${RESET} Smoke tests..."
    if ! uv run pytest -q -m "not slow and not integration" --no-header 2>&1 | tail -3; then
        printf "${RED}\n[pre-push] FAIL: tests fallidos.${RESET}\n"
        exit 1
    fi
fi

printf "${GREEN}[pre-push] OK — push permitido.${RESET}\n"
exit 0
