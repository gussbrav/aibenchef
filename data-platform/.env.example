# Copia este archivo a .env y rellena para correr la CLI localmente.
# En production las variables vienen de EasyPanel.

APP_ENV=development
LOG_LEVEL=INFO

# Postgres — apunta al postgres del proyecto azoramind en EasyPanel
DATABASE_URL=postgresql://postgres:Azoramind_1234@localhost:5432/aibenchef

# Storage raw
RAW_STORAGE_DIR=./local-data/raw

# SBS scraping
SBS_BASE_URL=https://www.sbs.gob.pe
SBS_DOWNLOAD_CONCURRENCY=8
SBS_DOWNLOAD_TIMEOUT_SECONDS=60
SBS_MAX_RETRIES=3

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium

# Observabilidad
SENTRY_DSN=
